# Public HTTPS origin of the production site. Used for the canonical URL, absolute
# social preview images, robots.txt, sitemap.xml and structured data.
# Set it before running the production build.
SITE_URL=https://your-domain.example

# Where early-access and partner signups are sent (server-side only).
# Receives a JSON POST: { type: "traveler" | "partner", ...fields, submittedAt }.
# Must return a 2xx status. Without it, the forms show "Signup isn't open yet" and nothing is saved.
SIGNUP_WEBHOOK_URL=

# Optional. Sent as "Authorization: Bearer <value>" so the receiver can reject other callers.
SIGNUP_WEBHOOK_SECRET=
